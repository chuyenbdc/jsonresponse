{
  "name": "shopping-monorepo",
  "private": true,
  "version": "0.1.0",
  "license": "UNLICENSED",
  "scripts": {
    "start:server": "npm --prefix server run start:dev",
    "start:web": "npm --prefix web run start -- --port 4200 --host 0.0.0.0 --proxy-config src/proxy.conf.json",
    "dev": "concurrently \"npm run start:server\" \"npm run start:web\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}